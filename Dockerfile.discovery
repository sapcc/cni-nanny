# builder
FROM golang:1.27@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS builder

WORKDIR /src/

COPY go.mod go.sum ./
COPY . ./

RUN CGO_ENABLED=0 \
    GOOS=linux \
    go build -o discovery cmd/discovery/discovery.go

# runner
FROM alpine:latest
LABEL source_repository="https://github.com/sapcc/cni-nanny"

WORKDIR /

COPY --from=builder /src/discovery /discovery
ENTRYPOINT ["/discovery"]
