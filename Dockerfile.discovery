# builder
FROM golang:1.27@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b AS builder

WORKDIR /src/

COPY go.mod go.sum ./
COPY . ./

RUN CGO_ENABLED=0 \
    GOOS=linux \
    go build -o discovery cmd/discovery/discovery.go

# runner
FROM alpine:latest
LABEL source_repository="https://github.com/sapcc/cni-nanny"

WORKDIR /

COPY --from=builder /src/discovery /discovery
ENTRYPOINT ["/discovery"]
